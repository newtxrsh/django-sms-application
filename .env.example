# Copy this file to .env and replace the placeholder values.
# NEVER commit the real .env file to GitHub.

# --- Django ---
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- textbee.dev (from https://textbee.dev/dashboard) ---
# API key generated on the textbee dashboard
TEXTBEE_API_KEY=your_textbee_api_key_here
# ID of the Android phone linked to your textbee account (shown on the dashboard)
TEXTBEE_DEVICE_ID=your_device_id_here
# Optional: SIM slot used to send (0 = SIM 1, 1 = SIM 2). Leave empty for the phone's default SIM.
TEXTBEE_SIM_SLOT=
